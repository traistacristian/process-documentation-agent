{
  "name": "process-documentation-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Process Documentation Agent - captures real task execution and turns it into standardised IT process documentation published to SharePoint.",
  "scripts": {
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"test/e2e/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^1.1.1",
    "@anthropic-ai/sdk": "^1.6.0",
    "@azure/identity": "^4.14.1",
    "@azure/msal-browser": "^4.30.0",
    "applicationinsights": "^3.17.0",
    "docx": "^9.15.3",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@microsoft/teams-js": "^2.57.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^6.4.5"
  }
}
