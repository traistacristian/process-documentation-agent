{
  "manifest_version": 3,
  "name": "Process Documentation Agent – Capture",
  "version": "1.1.0",
  "description": "Captures the steps of an IT process while a Process Documentation Agent recording is active, and guides colleagues through published procedures.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Process Documentation Agent – not recording"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}
